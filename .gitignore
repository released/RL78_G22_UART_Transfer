# Keep the role-specific delivery; preserve other outputs locally.
/DefaultBuild/*
!/DefaultBuild/RL78_G22_UART_Transfer.hex
/tmp/
/test_bins/
*.mtud
QualityReport*.txt
/boot_app.bin
/boot_app.hex
*.rcpe

# Merge into the project's .gitignore after reviewing actual content/paths.
# These are local engineering records, not public user guides or source tests.
# Already tracked files/history need separate review; ignore alone is insufficient.
/AGENTS.md
/AGENTS_for_Codex.md
/CLAUDE.md
/WORKSPACE_RULES.md
/HANDOFF.md
/CODEX_HANDOFF.md
/SELF_CHECK.md
/MANUAL_CLEANUP.md
/PROJECT_README_TEMPLATE.md
/.codex/
/.claude/
/github_push.local.psd1

# Dedicated internal records and generated verification payloads.
/docs/internal/
/docs/development/
/artifacts/audits/
/artifacts/tests/
/.verify/

# Live environment values stay local. Only a reviewed example is publishable.
/.env*
!/.env.example

# Classify SPEC.md and additional logs/captures/data by purpose before upload.
# Preserve README/user/architecture/protocol guides, LICENSE/NOTICE, meaningful
# tests/fixtures source and required runtime assets. Do not ignore all *.md,
# docs/, tests/ or build/. Merge compiler intermediates separately.

/github_push.bat
/SmartManual Docs/
/.settings/
/docs/verification/
/src/smc_gen/r_bsp/doc/**/*.pdf
/*.mtds
